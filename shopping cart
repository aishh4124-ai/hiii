import React, { useState } from "react";
import "./App.css";

function App() {
  const products = [
    { name: "Laptop", price: 50000 },
    { name: "Mobile", price: 20000 },
    { name: "Headphones", price: 2000 }
  ];

  const [cart, setCart] = useState([]);

  return (
    <div>
      <h1>Shopping Cart</h1>

      <h2>Products</h2>
      <div className="products">
        {products.map((p) => (
          <div className="product" key={p.name}>
            <h3>{p.name}</h3>
            <p>₹{p.price}</p>
            <button onClick={() => setCart([...cart, p])}>
              Add to Cart
            </button>
          </div>
        ))}
      </div>

      <h2>Cart</h2>
      {cart.map((p, i) => (
        <div className="cart" key={i}>
          {p.name} - ₹{p.price}
          <button
            onClick={() =>
              setCart(cart.filter((_, x) => x !== i))
            }
          >
            Remove
          </button>
        </div>
      ))}

      <h2>
        Total: ₹
        {cart.reduce((total, p) => total + p.price, 0)}
      </h2>
    </div>
  );
}

export default App;
