apiVersion: apps/v1
kind: Deployment
metadata:
  name: mygame
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mygame
  template:
    metadata:
      labels:
        app: mygame
    spec:
      containers:
      - name: http-echo
        image: hashicorp/http-echo
        args:
          - "-listen=:5678"
          - "-text=Kubernetes Lab Successfully Completed!"
        ports:
        - containerPort: 5678
---
apiVersion: v1
kind: Service
metadata:
  name: mygame
spec:
  type: LoadBalancer
  selector:
    app: mygame
  ports:
  - name: http
    port: 8080
    targetPort: 5678
    protocol: TCP
