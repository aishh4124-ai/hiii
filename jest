import React, { useState } from "react";

function Home() {
  const [count, setCount] = useState(4);

  return (
    <div>
      <button onClick={() => setCount(count + 1)}>+</button>
      <h2>{count}</h2>
      <button onClick={() => setCount(count - 1)}>-</button>
    </div>
  );
}

export default Home;
